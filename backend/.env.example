PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_secret

# Secret key a new admin must enter to register
ADMIN_SECRET_KEY=your_admin_secret_key
NODE_ENV=development

# Comma-separated frontend origins (local + hosted)
CLIENT_URL=http://localhost:5173,https://www.goodshot.me

RESEND_API_KEY=re_*********************************
RESEND_FROM_EMAIL=YOURNAME <noreply@yourdomain.com>

# Payment proof images. Required in production: without these, proofs are saved to the
# server's disk, which Render wipes on every deploy. Either the three values or CLOUDINARY_URL.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Time zone the club runs on; booking times and "today" follow it (default Asia/Karachi)
# CLUB_TIME_ZONE=Asia/Karachi
